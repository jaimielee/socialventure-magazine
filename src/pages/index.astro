---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Socialventure Magazine" description="중소 제조 공장, 브랜드, AI, 콘텐츠 현장에서 직접 부딪히며 기록하는 아카이브입니다.">
  <main class="mx-auto grid min-h-[calc(100vh-220px)] w-[min(1120px,calc(100vw_-_32px))] items-center py-16 sm:py-24">
    <section class="max-w-5xl">
      <h1 class="text-[clamp(4rem,15vw,10rem)] font-extrabold leading-[0.86] tracking-normal text-ink">
        Building<br />
        small<br />
        <span class="text-blue">brand</span><br />
        systems.
      </h1>
      <p class="mt-10 max-w-3xl text-[clamp(1.35rem,3vw,2.5rem)] font-semibold leading-[1.28] tracking-normal text-ink">
        중소 브랜드와 제조업의<br />
        콘텐츠 제작과 AI 기반 디지털 전환을<br />
        현장에서 직접 실험하고 기록합니다.
      </p>
    </section>
  </main>
</BaseLayout>
