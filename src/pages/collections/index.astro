---
import { getCollection } from 'astro:content';
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const collections = (await getCollection('collections')).sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const categories = ['ALL', '디지털 전환&AI', '콘텐츠 제작', '마케팅&브랜딩'];
---

<BaseLayout title="실전 팁">
  <main class="mx-auto w-[min(1120px,calc(100vw_-_32px))] py-12">
    <section class="mb-6 flex flex-wrap gap-2" aria-label="실전 팁 카테고리">
      {categories.map((category, index) => (
        <button
          class:list={[
            'collection-category-filter border px-3 py-2 text-sm font-semibold transition',
            index === 0 ? 'border-blue bg-blue text-white' : 'border-line bg-white text-muted hover:border-blue hover:text-blue',
          ]}
          type="button"
          data-filter-category={category}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {category}
        </button>
      ))}
    </section>
    <section class="grid gap-3 md:grid-cols-2" data-collection-list>
      {collections.map((entry) => (
        <div data-collection-card data-category={entry.data.category}>
          <ContentCard href={`/collections/${entry.id}`} title={entry.data.title} description={entry.data.description} category={entry.data.category} tags={entry.data.tags} status={entry.data.status} />
        </div>
      ))}
      <p class="hidden border border-line bg-white p-5 text-sm text-muted md:col-span-2" data-empty-category>
        선택한 카테고리에 해당하는 실전 팁이 없습니다.
      </p>
    </section>
  </main>
  <script>
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.collection-category-filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-collection-card]'));
    const emptyMessage = document.querySelector<HTMLElement>('[data-empty-category]');

    filterButtons.forEach((filterButton) => {
      filterButton.addEventListener('click', () => {
        const selectedCategory = filterButton.dataset.filterCategory || 'ALL';
        let visibleCount = 0;

        filterButtons.forEach((button) => {
          const isActive = button === filterButton;
          button.setAttribute('aria-pressed', String(isActive));
          button.classList.toggle('border-blue', isActive);
          button.classList.toggle('bg-blue', isActive);
          button.classList.toggle('text-white', isActive);
          button.classList.toggle('border-line', !isActive);
          button.classList.toggle('bg-white', !isActive);
          button.classList.toggle('text-muted', !isActive);
        });

        cards.forEach((card) => {
          const shouldShow = selectedCategory === 'ALL' || card.dataset.category === selectedCategory;
          card.classList.toggle('hidden', !shouldShow);
          if (shouldShow) visibleCount += 1;
        });

        emptyMessage?.classList.toggle('hidden', visibleCount > 0);
      });
    });
  </script>
</BaseLayout>
