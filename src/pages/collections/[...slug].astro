---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisibleContent } from '../../lib/contentVisibility';

export async function getStaticPaths() {
  const collections = (await getCollection('collections')).filter(isVisibleContent);
  return collections.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <main class="mx-auto w-[min(920px,calc(100vw_-_32px))] py-12">
    <header class="border-b border-line pb-8">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-blue">실전 팁 / {entry.data.category}</p>
      <h1 class="text-[clamp(2.8rem,12vw,7rem)] font-extrabold leading-[0.9]">{entry.data.title}</h1>
      {entry.data.subtitle && <p class="mt-5 max-w-2xl text-2xl font-semibold leading-snug text-ink">{entry.data.subtitle}</p>}
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{entry.data.description}</p>
    </header>
    <article class="prose-magazine mt-8 [&_p]:my-4 [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:my-2">
      <Content />
    </article>
    {entry.data.tags.length ? (
      <footer class="mt-10 flex flex-wrap gap-2 border-t border-line pt-5">
        {entry.data.tags.map((tag) => <span class="border border-line bg-white px-3 py-1.5 text-sm text-muted">#{tag}</span>)}
      </footer>
    ) : null}
  </main>
</BaseLayout>
