---
import '../styles/global.css';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Socialventure Admin</title>
    <style>
      body {
        margin: 0;
        background: #f7fbff;
        color: #111827;
        font-family: "Pretendard Variable", Pretendard, Apple SD Gothic Neo, Noto Sans KR, system-ui, sans-serif;
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
      }
    </style>
  </head>
  <body>
    <script is:inline>
      if (window.location.pathname === '/admin') {
        window.location.replace('/admin/');
      }
    </script>
    <script is:inline src="https://unpkg.com/decap-cms@^3.8.0/dist/decap-cms.js"></script>
  </body>
</html>
