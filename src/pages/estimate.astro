---
import BaseLayout from '../layouts/BaseLayout.astro';
const fields = [
  ['project', '견적 제목', '예: 브랜드 영상 제작'], ['recipient', '수신 회사 / 고객', '회사명 또는 고객명'],
  ['contact', '수신 담당자', '담당자명'], ['number', '견적 번호', '예: QT-20261002-01'],
  ['date', '작성일', ''], ['valid', '견적 유효기간', '예: 작성일로부터 14일'],
  ['company', '공급자 상호', '상호명'], ['owner', '대표자', '대표자명'],
  ['business', '사업자등록번호', '000-00-00000'], ['phone', '연락처 / 이메일', '연락처 또는 이메일'],
  ['address', '사업장 주소', '사업장 주소'],
];
---
<BaseLayout title="견적서 만들기 | Socialventure" description="품목과 금액을 입력하고 견적서를 인쇄하거나 PDF로 저장하세요.">
  <main class="quote-workspace">
    <header class="editor-only intro"><p class="eyebrow">QUOTATION STUDIO</p><h1>견적서 만들기</h1><p>내용을 입력하면 견적서가 바로 완성됩니다.</p></header>
    <div class="editor-only toolbar">
      <button id="print-quote" class="primary">인쇄 / PDF 저장</button><button id="save-quote">브라우저에 저장</button><button id="export-quote">파일로 저장</button><label class="file-button">파일 불러오기<input id="import-quote" type="file" accept="application/json,.json" /></label><button id="reset-quote">새 견적서</button>
    </div>
    <p class="editor-only storage-note">입력 내용은 서버에 전송하지 않습니다. 브라우저 저장은 이 기기에서만 사용할 수 있습니다. PDF는 인쇄창의 ‘PDF로 저장’을 선택하세요.</p>
    <p id="quote-status" class="editor-only status" role="status" aria-live="polite"></p>
    <div class="workspace-grid">
      <form id="quote-form" class="editor-only editor" novalidate>
        <section><h2>01 / 기본 정보</h2><div class="field-grid">{fields.slice(0,6).map(([id,label,placeholder]) => <label>{label}<input name={id} type={id === 'date' ? 'date' : 'text'} placeholder={placeholder} maxlength="200" /></label>)}</div></section>
        <section><h2>02 / 공급자 정보</h2><p class="hint">저장하신 플러그인 공급자 정보가 고정으로 적용됩니다.</p><div class="field-grid">{fields.slice(6).map(([id,label,placeholder]) => <label>{label}<input name={id} placeholder={placeholder} maxlength="200" readonly /></label>)}</div></section>
        <section><div class="section-heading"><h2>03 / 견적 항목</h2><button type="button" id="add-item">+ 항목 추가</button></div><div id="item-inputs"></div><label class="vat-option"><input name="vat" type="checkbox" checked /> 부가세 10% 별도 계산</label><p class="hint">항목별 금액을 입력하세요. 부가세 제외 시 세액은 0원입니다.</p></section>
        <section><h2>04 / 비고</h2><label>납기·결제 조건·포함 범위 등<textarea name="notes" rows="5" maxlength="5000" placeholder="예: 작업 기간은 계약 후 2주입니다.&#10;수정은 2회 포함됩니다."></textarea></label></section>
      </form>
      <div class="preview-wrap"><p class="editor-only preview-label">미리보기 · A4</p><article id="quote-document" class="paper">
        <div class="document-head"><img src="/quote-logo.svg" width="147" height="20" alt="공급자 로고" /><div><p class="eyebrow">QUOTATION</p><h2>견적서</h2></div></div>
        <div class="meta"><span>문서번호 <b data-value="number"></b></span></div>
        <h3 data-value="project" class="project-title"></h3>
        <div class="parties"><section><p class="eyebrow">TO / 수신</p><h3><span data-value="recipient"></span> 귀하</h3><p data-value="contact"></p><p class="greeting">아래와 같이 견적드립니다.</p></section><section class="supplier"><h3>공급자</h3>{fields.slice(6).map(([id,label]) => <p><span>{label}</span><b data-value={id}></b></p>)}</section></div>
        <div class="total-banner"><span>총 견적금액 <small id="tax-label"></small></span><strong id="grand-total"></strong></div>
        <table class="quote-items"><colgroup><col style="width:12%"/><col style="width:60%"/><col style="width:28%"/></colgroup><thead><tr><th>No.</th><th>품목 / 작업 내용</th><th>금액</th></tr></thead><tbody id="preview-items"></tbody></table>
        <div class="totals"><p><span>공급가액</span><b id="supply-total"></b></p><p><span>부가세</span><b id="vat-total"></b></p><p class="final"><span>합계</span><b id="bottom-total"></b></p></div>
        <div class="document-end"><section class="conditions"><h3>비고</h3><p id="valid-line" hidden>유효기간: <span data-value="valid"></span></p><p data-value="notes"></p></section>
        <div class="document-footer"><span>작성일 <b data-value="date"></b></span><span data-value="company"></span></div></div>
      </article></div>
    </div>
  </main>
</BaseLayout>
<script>
  import '../scripts/quote-editor';
</script>
<style>
  .quote-workspace{max-width:1440px;margin:0 auto;padding:40px 24px}.intro h1{font-size:clamp(30px,5vw,48px);font-weight:800;margin:8px 0}.intro>p:last-child{color:#5f6f82}.eyebrow{font-size:10px;font-weight:700;letter-spacing:2px;color:#2a7fdb}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin:24px 0 12px}button,.file-button{border:1px solid #d7e3ef;background:white;border-radius:6px;padding:10px 14px;font-size:13px;font-weight:600;cursor:pointer}.primary{background:#172e49;color:white;border-color:#172e49}.file-button{position:relative}.file-button input{position:absolute;width:1px;height:1px;opacity:0}.file-button:focus-within{outline:2px solid #2a7fdb;outline-offset:2px}.storage-note,.hint{font-size:12px;line-height:1.7;color:#5f6f82}.status{min-height:24px;font-size:13px;color:#245687;margin:8px 0 16px}.workspace-grid{display:grid;grid-template-columns:minmax(300px,0.85fr) minmax(540px,1.3fr);gap:28px;align-items:start}.editor{display:grid;gap:16px}.editor section{background:white;border:1px solid #d7e3ef;border-radius:10px;padding:20px}.editor h2{font-size:15px;font-weight:700;margin-bottom:16px}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.editor :global(label){display:grid;gap:6px;font-size:12px;color:#526172}.editor :global(input),.editor textarea{width:100%;background:#fafcfe;border:1px solid #cdd9e5;border-radius:5px;padding:10px;color:#172e49;font:inherit;font-size:14px;min-width:0}.editor :global(input:focus),.editor textarea:focus{outline:2px solid #2a7fdb;outline-offset:1px}.section-heading{display:flex;justify-content:space-between;align-items:baseline;gap:8px}.editor .vat-option{display:flex;align-items:center;margin:18px 0 8px}.vat-option input{width:auto}.preview-label{font-size:12px;color:#5f6f82;margin-bottom:10px}.paper{background:white;padding:32px;border-top:5px solid #172e49;box-shadow:0 12px 50px #1a35531a;color:#172e49;font-size:12px}.document-head{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #172e49;padding-bottom:24px}.document-head img{max-width:45%;height:auto}.document-head h2{font-size:34px;font-weight:800;letter-spacing:7px}.meta{display:flex;justify-content:space-between;gap:12px;font-size:10px;color:#68778b;margin:16px 0}.meta b{margin-left:8px;color:#172e49}.project-title{font-size:19px;font-weight:700;margin:22px 0;overflow-wrap:anywhere}.parties{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}.parties h3{font-weight:700;font-size:16px;margin:8px 0}.greeting{color:#68778b;margin-top:16px}.supplier{border:1px solid #d7e3ef;padding:10px}.supplier h3{font-size:12px;margin:0 0 8px}.supplier p{display:grid;grid-template-columns:72px 1fr;gap:6px;border-top:1px solid #eef1f5;padding:5px 0;font-size:10px}.supplier span{color:#68778b}.supplier b{font-weight:500;overflow-wrap:anywhere}.total-banner{background:#172e49;color:white;padding:18px;display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px}.total-banner small{display:block;font-size:10px;margin-top:3px}.total-banner strong{font-size:clamp(18px,2vw,27px);font-variant-numeric:tabular-nums}.quote-items{width:100%;border-collapse:collapse;table-layout:fixed}.quote-items th{background:#edf3f9;padding:12px 16px;font-size:10px}.totals{width:55%;margin:20px 0 20px auto}.totals p{display:flex;justify-content:space-between;gap:12px;padding:9px;border-bottom:1px solid #d7e3ef}.totals .final{background:#edf3f9;font-size:14px}.conditions{background:#f6f9fc;border-left:3px solid #2a7fdb;padding:16px;margin-top:24px;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8}.conditions h3{font-weight:700;margin-bottom:6px}.document-footer{border-top:1px solid #d7e3ef;margin-top:32px;padding-top:14px;display:flex;justify-content:space-between;color:#68778b}.parties p{overflow-wrap:anywhere}
  :global(.quote-row-editor){border-top:1px solid #d7e3ef;padding:16px 0;display:grid;gap:10px;grid-template-columns:minmax(0,2fr) minmax(0,1fr)}:global(.quote-row-editor .wide input){text-align:center}:global(.quote-row-editor .remove){justify-self:end;grid-column:span 2;color:#914235;padding:5px 9px}:global(.quote-items td){padding:16px 16px;border-bottom:1px solid #e5eaf0;font-size:11px;line-height:1.6;vertical-align:middle;overflow-wrap:anywhere}:global(.quote-items td:last-child){text-align:right;font-variant-numeric:tabular-nums}
  :global(.quote-items td:first-child),:global(.quote-items td:nth-child(2)){text-align:center}.quote-items th:last-child{text-align:right}.quote-items th:first-child,:global(.quote-items td:first-child){padding-left:6px;padding-right:6px;white-space:nowrap}.quote-items th{text-align:center}.conditions [hidden]{display:none}.conditions{min-height:90px}.editor input[readonly]{background:#edf3f9;color:#526172}
  @media(max-width:1000px){.workspace-grid{grid-template-columns:1fr}.preview-wrap{max-width:800px;width:100%;margin:auto}}@media(max-width:540px){.quote-workspace{padding:28px 12px}.field-grid{grid-template-columns:1fr}.paper{padding:16px}.parties{grid-template-columns:1fr}.total-banner{padding:12px}.meta{flex-direction:column}.totals{width:80%}}
  @media print{
    .paper{line-height:1.35}
    .meta{margin:3mm 0}.project-title{margin:4mm 0;font-size:17px}.parties{margin-bottom:4mm;gap:5mm}.greeting{margin-top:3mm}.supplier{padding:2mm}.supplier p{padding:1mm 0}
    .total-banner{padding:3mm 4mm;margin-bottom:4mm}.quote-items th{padding-top:2.5mm;padding-bottom:2.5mm}:global(.quote-items td){padding-top:3mm;padding-bottom:3mm;line-height:1.4}
    .totals{margin-top:4mm;margin-bottom:4mm}.totals p{padding:2mm}.conditions{margin-top:4mm;padding:3mm;min-height:14mm;line-height:1.5}.document-footer{margin-top:4mm;padding-top:3mm;break-inside:avoid}.document-end{break-inside:avoid}
@page{size:A4;margin:14mm}:global(body){background:white!important}:global(body>.min-h-screen){min-height:0}:global(body>.min-h-screen>header),:global(body>.min-h-screen>footer),:global(.accent-rule),:global(#mobile-menu),:global(.note-modal),.editor-only{display:none!important}.quote-workspace{padding:0;max-width:none}.workspace-grid{display:block}.paper{padding:0;box-shadow:none;border-top-width:4px;font-size:11px}.preview-wrap{max-width:none}.parties{grid-template-columns:1fr 1fr}.meta{flex-direction:row}.quote-items thead{display:table-header-group}:global(.quote-items tr){break-inside:avoid}.conditions,.totals,.document-head,.parties{break-inside:avoid}.document-head{display:grid;grid-template-columns:1fr auto;align-items:center;gap:10mm;padding:6mm 0 5mm;min-height:24mm;box-sizing:border-box}.document-head img{display:block;width:39mm;height:auto;max-width:none;object-fit:contain}.document-head>div{text-align:right;white-space:nowrap}.document-head .eyebrow{font-size:8pt;line-height:1.2;letter-spacing:1.5pt;margin:0 0 3mm}.document-head h2{font-size:26pt;line-height:1.15;letter-spacing:3pt;margin:0}.total-banner strong{font-size:26px}.paper{-webkit-print-color-adjust:exact;print-color-adjust:exact}.totals{width:45%}}
</style>
