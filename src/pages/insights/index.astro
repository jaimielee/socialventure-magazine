---
import { getCollection } from 'astro:content';
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const insights = (await getCollection('insights')).sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
---

<BaseLayout title="Insights">
  <main class="mx-auto w-[min(1120px,calc(100vw_-_32px))] py-12">
    <header class="mb-8 border-b border-line pb-8">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-blue">Short Cards</p>
      <h1 class="text-[clamp(3rem,12vw,7rem)] font-extrabold leading-[0.9]">Insights</h1>
    </header>
    <section class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
      {insights.map((entry) => (
        <ContentCard href={`/insights/${entry.id}`} title={entry.data.title} description={entry.data.description} category={entry.data.category} tags={entry.data.tags} status={entry.data.status} />
      ))}
    </section>
  </main>
</BaseLayout>
