---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const insights = (await getCollection('insights')).sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const categories = ['전체', '짧은 인사이트', '책 인용', '영상 인용', '인터뷰 인용', '짧은 생각'];
---

<BaseLayout title="Insights">
  <main class="mx-auto w-[min(1120px,calc(100vw_-_32px))] py-12">
    <header class="mb-8 border-b border-line pb-8">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-blue">Short Notes</p>
      <h1 class="text-[clamp(3rem,12vw,7rem)] font-extrabold leading-[0.9]">Insights</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted">
        책, 영상, 현장에서 얻은 인사이트를 한 줄로 기록합니다.
      </p>
    </header>
    <p class="mb-4 text-sm text-muted">문장을 누르시면 클립보드에 복사 됩니다.</p>
    <section class="mb-6 flex flex-wrap gap-2" aria-label="Insight category filters">
      {categories.map((category, index) => (
        <button
          class:list={[
            'insight-category-filter border px-3 py-2 text-sm font-semibold transition',
            index === 0 ? 'border-blue bg-blue text-white' : 'border-line bg-white text-muted hover:border-blue hover:text-blue',
          ]}
          type="button"
          data-filter-category={category}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {category}
        </button>
      ))}
    </section>
    <section class="grid gap-2" data-insight-list>
      {insights.map((entry) => (
        <article class="border border-line bg-white p-4 transition hover:border-blue sm:p-5" data-insight-card data-category={entry.data.category}>
          <button class="copy-insight block w-full text-left" type="button" data-copy-text={entry.data.coreSentence}>
            <p class="text-xl font-semibold leading-snug text-ink sm:text-2xl">{entry.data.coreSentence}</p>
          </button>
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs leading-5 text-muted">
            <span class="font-semibold uppercase tracking-[0.14em] text-blue">{entry.data.category}</span>
            {entry.data.source && (
              entry.data.sourceUrl
                ? <a class="hover:text-blue" href={entry.data.sourceUrl} target="_blank" rel="noreferrer">{entry.data.source}</a>
                : <span>{entry.data.source}</span>
            )}
            {entry.data.tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
            <span class="copy-insight-feedback hidden text-blue">Copied</span>
          </div>
        </article>
      ))}
      <p class="hidden border border-line bg-white p-5 text-sm text-muted" data-empty-filter>
        선택한 유형에 해당하는 인사이트가 없습니다.
      </p>
    </section>
  </main>
  <script>
    document.addEventListener('click', async (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('.copy-insight') : null;
      if (!button) return;
      const text = button.dataset.copyText || '';
      if (!text) return;
      await navigator.clipboard.writeText(text);
      const card = button.closest('article');
      const feedback = card?.querySelector('.copy-insight-feedback');
      feedback?.classList.remove('hidden');
      window.setTimeout(() => feedback?.classList.add('hidden'), 1200);
    });

    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.insight-category-filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-insight-card]'));
    const emptyMessage = document.querySelector<HTMLElement>('[data-empty-filter]');

    filterButtons.forEach((filterButton) => {
      filterButton.addEventListener('click', () => {
        const selectedCategory = filterButton.dataset.filterCategory || '전체';
        let visibleCount = 0;

        filterButtons.forEach((button) => {
          const isActive = button === filterButton;
          button.setAttribute('aria-pressed', String(isActive));
          button.classList.toggle('border-blue', isActive);
          button.classList.toggle('bg-blue', isActive);
          button.classList.toggle('text-white', isActive);
          button.classList.toggle('border-line', !isActive);
          button.classList.toggle('bg-white', !isActive);
          button.classList.toggle('text-muted', !isActive);
        });

        cards.forEach((card) => {
          const shouldShow = selectedCategory === '전체' || card.dataset.category === selectedCategory;
          card.classList.toggle('hidden', !shouldShow);
          if (shouldShow) visibleCount += 1;
        });

        emptyMessage?.classList.toggle('hidden', visibleCount > 0);
      });
    });
  </script>
</BaseLayout>
