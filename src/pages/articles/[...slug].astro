---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DetailBlocks from '../../components/DetailBlocks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type LocalArticle = CollectionEntry<'articles'>;
const entry = Astro.props.entry as LocalArticle;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <main class="mx-auto w-[min(920px,calc(100vw_-_32px))] py-12">
    <header class="border-b border-line pb-8">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-blue">Article / {entry.data.category} / {entry.data.readingMinutes} min</p>
      <h1 class="text-[clamp(2.8rem,12vw,7rem)] font-extrabold leading-[0.9]">{entry.data.title}</h1>
      {entry.data.description && <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">{entry.data.description}</p>}
    </header>
    <DetailBlocks
      coreSentence={entry.data.coreSentence}
      source={entry.data.source}
      myThought={entry.data.myThought}
      relatedNotes={entry.data.relatedNoteIds}
      imageGuide={entry.data.imageGuide}
      checklist={entry.data.checklist}
    />
    <article class="prose-magazine">
      <Content />
    </article>
  </main>
</BaseLayout>
