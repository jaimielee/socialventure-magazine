---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type LocalArticle = CollectionEntry<'articles'>;
const entry = Astro.props.entry as LocalArticle;
const { Content } = await render(entry);
const relatedSources = [...entry.data.relatedSources, ...entry.data.relatedNoteIds];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <main class="mx-auto w-[min(920px,calc(100vw_-_32px))] py-12">
    <header class="border-b border-line pb-8">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-blue">Blog / {entry.data.category} / {entry.data.readingMinutes} min</p>
      <h1 class="text-[clamp(2.8rem,12vw,7rem)] font-extrabold leading-[0.9]">{entry.data.title}</h1>
      {entry.data.description && <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">{entry.data.description}</p>}
    </header>
    <aside class="my-8 grid gap-3">
      <section class="border border-blue bg-white p-5 shadow-[0_18px_44px_rgba(42,127,219,0.08)]">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-blue">Core Sentence</p>
        <blockquote class="m-0 text-2xl font-semibold leading-snug sm:text-3xl">{entry.data.coreSentence}</blockquote>
      </section>
      <section class="grid gap-3 md:grid-cols-2">
        <div class="border border-line bg-white p-5">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-blue">Source</p>
          {entry.data.sourceUrl
            ? <a class="leading-7 text-ink underline decoration-blue/30 underline-offset-4 hover:text-blue" href={entry.data.sourceUrl} target="_blank" rel="noreferrer">{entry.data.source || entry.data.sourceUrl}</a>
            : <p class="leading-7 text-ink">{entry.data.source || '출처 미정'}</p>}
        </div>
        <div class="border border-line bg-white p-5">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-blue">Related Sources</p>
          {relatedSources.length ? (
            <ul class="grid gap-2 text-sm leading-6 text-ink">
              {relatedSources.map((item) => (
                <li>
                  {item.startsWith('http')
                    ? <a class="underline decoration-blue/30 underline-offset-4 hover:text-blue" href={item} target="_blank" rel="noreferrer">{item}</a>
                    : item}
                </li>
              ))}
            </ul>
          ) : <p class="text-sm text-muted">연결된 원본 소스가 아직 없습니다.</p>}
        </div>
      </section>
    </aside>
    <article class="prose-magazine">
      <Content />
    </article>
  </main>
</BaseLayout>
