---
import { getCollection } from 'astro:content';
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisibleContent } from '../../lib/contentVisibility';

const articles = (await getCollection('articles')).filter(isVisibleContent).sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
---

<BaseLayout title="Blog">
  <main class="mx-auto w-[min(1120px,calc(100vw_-_32px))] py-12">
    <header class="mb-8 border-b border-line pb-8">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-blue">Long Form</p>
      <h1 class="text-[clamp(3rem,12vw,7rem)] font-extrabold leading-[0.9]">Blog</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted">긴 글, 에세이, 정리된 생각, 블로그형 글을 모읍니다.</p>
    </header>
    <section class="grid gap-3 md:grid-cols-2">
      {articles.map((entry) => (
        <ContentCard href={`/articles/${entry.id}`} title={entry.data.title} description={entry.data.description} category={entry.data.category} tags={entry.data.tags} status={entry.data.status} />
      ))}
    </section>
  </main>
</BaseLayout>
