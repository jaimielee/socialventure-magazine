---
import { getCollection } from 'astro:content';
import SearchBox from '../components/SearchBox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const [insights, articles, collections] = await Promise.all([
  getCollection('insights'),
  getCollection('articles'),
  getCollection('collections'),
]);

const items = [
  ...insights.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    tags: entry.data.tags,
    type: 'Insight',
    url: `/insights/${entry.id}`,
  })),
  ...articles.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    tags: entry.data.tags,
    type: 'Article',
    url: `/articles/${entry.id}`,
  })),
  ...collections.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    tags: entry.data.tags,
    type: 'Collection',
    url: `/collections/${entry.id}`,
  })),
];
---

<BaseLayout title="Search">
  <main class="mx-auto w-[min(920px,calc(100vw_-_32px))] py-12">
    <header class="mb-8 border-b border-line pb-8">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-blue">Fuse.js</p>
      <h1 class="text-[clamp(3rem,12vw,7rem)] font-extrabold leading-[0.9]">Search</h1>
    </header>
    <SearchBox items={items} />
  </main>
</BaseLayout>
