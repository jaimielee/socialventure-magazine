---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Socialventure Magazine',
  description = '중소 제조업 현장에서 브랜드, 시스템, AI를 실험하며 얻은 인사이트와 실행 기록을 공유하는 아카이브입니다.',
} = Astro.props;
const nav = [
  ['/', 'Home'],
  ['/insights', 'Insights'],
  ['/articles', 'Blog'],
  ['/collections', '실전 팁'],
  ['/together', '함께하기'],
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen">
      <div class="accent-rule"></div>
      <header class="mx-auto flex w-[min(1120px,calc(100vw_-_32px))] items-center justify-between gap-5 border-b border-line py-5">
        <a href="/" class="text-lg font-extrabold tracking-tight text-ink">
          SOCIALVENTURE<span class="text-blue">.</span>KR
        </a>
        <nav class="flex items-center gap-2 text-sm text-muted sm:gap-5">
          <div class="hidden items-center gap-5 md:flex">
            {nav.map(([href, label]) => <a class="hover:text-blue" href={href}>{label}</a>)}
          </div>
          <a class="inline-flex size-9 items-center justify-center border border-line text-muted hover:border-blue hover:text-blue" href="/search" aria-label="Search">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m16.5 16.5 4 4"></path>
            </svg>
          </a>
          <button class="mobile-menu-button inline-flex size-9 items-center justify-center border border-line text-muted hover:border-blue hover:text-blue md:hidden" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 7h16"></path>
              <path d="M4 12h16"></path>
              <path d="M4 17h16"></path>
            </svg>
          </button>
        </nav>
      </header>
      <div id="mobile-menu" class="mobile-menu mx-auto hidden w-[min(1120px,calc(100vw_-_32px))] border-b border-line bg-paper py-3 md:hidden" data-mobile-menu>
        <div class="grid gap-2 text-sm font-semibold text-ink">
          {nav.map(([href, label]) => <a class="border border-line bg-white px-4 py-3 hover:border-blue hover:text-blue" href={href}>{label}</a>)}
        </div>
      </div>
      <slot />
      <footer class="mx-auto mt-20 w-[min(1120px,calc(100vw_-_32px))] border-t border-line py-8 text-sm text-muted">
        Building small brand systems in the field.
      </footer>
      <div class="note-modal" data-note-modal-root aria-hidden="true">
        <div class="note-modal__backdrop" data-note-modal-close></div>
        <section class="note-modal__panel" role="dialog" aria-modal="true" aria-label="Note detail">
          <button class="note-modal__close" type="button" data-note-modal-close aria-label="Close note">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
          <div class="note-modal__content" data-note-modal-content>
            <p class="note-modal__loading">불러오는 중입니다.</p>
          </div>
        </section>
      </div>
    </div>
    <script is:inline>
      (() => {
        const root = document.querySelector('[data-note-modal-root]');
        const content = document.querySelector('[data-note-modal-content]');
        const closeTargets = document.querySelectorAll('[data-note-modal-close]');
        const menuToggle = document.querySelector('[data-menu-toggle]');
        const mobileMenu = document.querySelector('[data-mobile-menu]');
        let lastFocused = null;
        let activeController = null;

        if (!root || !content) return;

        menuToggle?.addEventListener('click', () => {
          const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isOpen));
          mobileMenu?.classList.toggle('hidden', isOpen);
        });

        function setOpen(isOpen) {
          root.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
          document.documentElement.classList.toggle('note-modal-open', isOpen);
          document.body.classList.toggle('note-modal-open', isOpen);
        }

        function closeModal() {
          if (activeController) activeController.abort();
          setOpen(false);
          if (lastFocused instanceof HTMLElement) lastFocused.focus();
        }

        async function openModal(url, trigger) {
          lastFocused = trigger;
          if (activeController) activeController.abort();
          activeController = new AbortController();
          content.innerHTML = '<p class="note-modal__loading">불러오는 중입니다.</p>';
          setOpen(true);
          root.querySelector('[data-note-modal-close]')?.focus();

          try {
            const response = await fetch(url, { signal: activeController.signal });
            if (!response.ok) throw new Error('Failed to load note');
            const html = await response.text();
            const page = new DOMParser().parseFromString(html, 'text/html');
            const main = page.querySelector('main');
            if (!main) throw new Error('Missing note content');
            content.replaceChildren(main.cloneNode(true));
          } catch (error) {
            if (error?.name === 'AbortError') return;
            window.location.href = url;
          }
        }

        document.addEventListener('click', (event) => {
          const link = event.target.closest?.('a[data-note-modal]');
          if (!link) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target === '_blank') return;
          const url = new URL(link.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          event.preventDefault();
          openModal(url.pathname, link);
        });

        closeTargets.forEach((target) => {
          target.addEventListener('click', closeModal);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && root.getAttribute('aria-hidden') === 'false') {
            closeModal();
          }
        });
      })();
    </script>
  </body>
</html>
