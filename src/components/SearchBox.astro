---
interface SearchItem {
  title: string;
  description: string;
  category: string;
  tags: string[];
  type: string;
  url: string;
}

interface Props {
  items: SearchItem[];
}

const { items } = Astro.props;
---

<section class="border border-blue bg-white p-4 shadow-[0_18px_44px_rgba(42,127,219,0.10)] sm:p-6">
  <label class="grid gap-3">
    <span class="text-xs font-semibold uppercase tracking-[0.16em] text-blue">Search all drafts</span>
    <input id="search-input" class="w-full border border-line px-4 py-3 text-lg outline-none focus:border-blue" placeholder="브랜드, 콘텐츠, 신앙, 카드뉴스..." />
  </label>
  <script is:inline id="search-data" type="application/json" set:html={JSON.stringify(items)} />
  <div id="search-results" class="mt-5 grid gap-3"></div>
</section>

<script>
  import Fuse from 'fuse.js';

  const input = document.querySelector<HTMLInputElement>('#search-input');
  const results = document.querySelector<HTMLDivElement>('#search-results');
  const dataNode = document.querySelector<HTMLScriptElement>('#search-data');
  interface ClientSearchItem {
    title: string;
    description: string;
    category: string;
    tags: string[];
    type: string;
    url: string;
  }

  const items = JSON.parse(dataNode?.textContent || '[]') as ClientSearchItem[];
  const fuse = new Fuse(items, {
    keys: ['title', 'description', 'category', 'tags', 'type'],
    threshold: 0.32,
  });

  function render(query = '') {
    if (!results) return;
    const list: ClientSearchItem[] = query.trim() ? fuse.search(query).map((result) => result.item) : items.slice(0, 12);
    results.innerHTML = list.map((item) => `
      <a class="block border border-line p-4 hover:border-blue hover:bg-mist/40" href="${item.url}" data-note-modal>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-blue">${item.type} / ${item.category}</p>
        <h2 class="mt-2 text-xl font-extrabold text-ink">${item.title}</h2>
        <p class="mt-2 text-sm leading-6 text-muted">${item.description || ''}</p>
      </a>
    `).join('');
  }

  input?.addEventListener('input', () => render(input.value));
  render();
</script>
