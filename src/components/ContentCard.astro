---
import StatusBadge from './StatusBadge.astro';

interface Props {
  href: string;
  title: string;
  description?: string;
  category?: string;
  tags?: string[];
  status?: 'draft' | 'review' | 'published';
  eyebrow?: string;
}

const { href, title, description = '', category = '', tags = [], status = 'draft', eyebrow = '' } = Astro.props;
---

<a href={href} class="group relative flex min-h-[240px] flex-col justify-between overflow-hidden border border-line bg-panel p-5 transition hover:-translate-y-0.5 hover:border-blue hover:bg-white hover:shadow-[0_18px_42px_rgba(42,127,219,0.12)]">
  <span class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-blue via-blue to-sun opacity-80 transition group-hover:opacity-100"></span>
  <div>
    <div class="mb-5 flex items-center justify-between gap-3">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue">{eyebrow || category}</p>
      <StatusBadge status={status} />
    </div>
    <h2 class="text-2xl font-extrabold leading-[1.08] tracking-normal text-ink group-hover:text-blue sm:text-3xl">{title}</h2>
    {description && <p class="mt-4 text-[15px] leading-7 text-muted">{description}</p>}
  </div>
  <div class="mt-8 flex flex-wrap gap-2">
    {tags.slice(0, 4).map((tag) => <span class="border border-line bg-mist/50 px-2 py-1 text-xs text-muted">#{tag}</span>)}
  </div>
</a>
