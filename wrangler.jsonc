{
	"compatibility_date": "2026-05-21",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "socialventure-magazine",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"workers_dev": true,
	"routes": [
		{
			"pattern": "socialventure.kr/*",
			"zone_name": "socialventure.kr"
		},
		{
			"pattern": "www.socialventure.kr/*",
			"zone_name": "socialventure.kr"
		}
	],
	"observability": {
		"enabled": true
	}
}
